# Copy to .env and set the public origins before building.
ROOST_WEBSITE_URL=https://roost.example.com
ROOST_DOCS_URL=https://docs.roost.example.com

# Optional Datadog Product Analytics (public browser configuration, never API keys).
# Analytics runs only in production builds with all three values set.
VITE_DATADOG_APPLICATION_ID=
VITE_DATADOG_CLIENT_TOKEN=
VITE_DATADOG_SITE=
VITE_DATADOG_ENV=production
