{
  "name": "@roost/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.cli.config.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:auth": "pnpm build && pnpm test:auth:production",
    "test:auth:production": "node --import tsx scripts/test-auth-production.ts",
    "test:threads:browser": "node --import tsx tests/browser/threads.ts",
    "test:mobile": "node --import tsx --test tests/mobile.test.ts tests/mobile-workspaces.test.ts",
    "test:mobile:production": "node --import tsx scripts/test-mobile-production.ts",
    "dev:mobile-fixture": "node --import tsx tests/fixtures/mobile-server.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@effect/platform-node": "0.108.1",
    "@fluentui/react-charts": "9.3.25",
    "@fluentui/react-provider": "9.22.20",
    "@fluentui/react-theme": "9.2.2",
    "@novnc/novnc": "1.5.0",
    "@simplewebauthn/server": "13.3.2",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-task-item": "3.31.3",
    "@tiptap/extension-task-list": "3.31.3",
    "@tiptap/extension-unique-id": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "croner": "10.0.1",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@rolldown/plugin-babel": "0.2.3",
    "@stylexjs/unplugin": "0.19.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "nitro": "3.0.260903-beta",
    "playwright": "1.58.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.2.2",
    "@roost/typescript-config": "workspace:*"
  }
}
