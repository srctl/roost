{
  "name": "roost",
  "version": "0.1.38",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.cli.config.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:auth:production && pnpm check:sites",
    "test": "node --import tsx --test tests/*.test.ts",
    "release:pack": "node scripts/package-release.mjs",
    "dev:marketing": "vite --config sites/marketing/vite.config.ts",
    "build:marketing": "vite build --config sites/marketing/vite.config.ts",
    "preview:marketing": "vite preview --config sites/marketing/vite.config.ts",
    "dev:docs": "vite --config sites/docs/vite.config.ts",
    "build:docs": "vite build --config sites/docs/vite.config.ts",
    "preview:docs": "vite preview --config sites/docs/vite.config.ts",
    "build:sites": "pnpm build:marketing && pnpm build:docs",
    "typecheck:sites": "tsc --project sites/tsconfig.json",
    "check:sites": "pnpm typecheck:sites && pnpm test:sites && pnpm build:sites",
    "test:sites": "node --import tsx --test sites/docs/*.test.tsx",
    "test:auth": "pnpm build && pnpm test:auth:production",
    "test:auth:production": "node --import tsx scripts/test-auth-production.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@effect/platform-node": "0.108.1",
    "@novnc/novnc": "1.5.0",
    "@simplewebauthn/server": "13.3.2",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "croner": "10.0.1",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "4.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@biomejs/biome": "2.5.12",
    "@rolldown/plugin-babel": "0.2.3",
    "@stylexjs/unplugin": "0.19.0",
    "@types/babel__core": "7.20.5",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "nitro": "3.0.260903-beta",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.2.2"
  },
  "bin": {
    "roost": "bin/roost"
  },
  "license": "MIT"
}
