{
  "name": "roost",
  "version": "0.1.43",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "roost": "bin/roost"
  },
  "license": "MIT",
  "pnpm": {
    "packageExtensions": {
      "@fluentui/react-charts@9.3.25": {
        "dependencies": {
          "@fluentui/react-menu": "9.25.4",
          "@fluentui/tokens": "1.0.0-alpha.24"
        }
      }
    }
  },
  "scripts": {
    "dev": "ROOST_DATA_DIR=\"${ROOST_DATA_DIR:-$PWD/.roost}\" pnpm --filter @roost/web dev",
    "dev:web": "pnpm dev",
    "build": "pnpm --filter @roost/web build",
    "build:all": "pnpm build && pnpm build:sites",
    "start": "ROOST_DATA_DIR=\"${ROOST_DATA_DIR:-$PWD/.roost}\" pnpm --filter @roost/web start",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build:all && pnpm test:auth:production && pnpm test:mobile:production",
    "test": "pnpm -r --if-present test",
    "release:pack": "node scripts/package-release.mjs",
    "dev:docs": "pnpm --filter @roost/docs dev",
    "build:docs": "pnpm --filter @roost/docs build",
    "preview:docs": "pnpm --filter @roost/docs preview",
    "dev:marketing": "pnpm --filter @roost/marketing dev",
    "build:marketing": "pnpm --filter @roost/marketing build",
    "preview:marketing": "pnpm --filter @roost/marketing preview",
    "build:sites": "pnpm --filter @roost/docs --filter @roost/marketing build",
    "typecheck:sites": "pnpm --filter @roost/docs --filter @roost/marketing typecheck",
    "test:sites": "pnpm --filter @roost/docs test",
    "check:sites": "pnpm typecheck:sites && pnpm test:sites && pnpm build:sites",
    "test:auth": "pnpm --filter @roost/web test:auth",
    "test:auth:production": "pnpm --filter @roost/web test:auth:production",
    "test:threads:browser": "pnpm --filter @roost/web test:threads:browser",
    "test:mobile": "pnpm --filter @roost/web test:mobile",
    "test:mobile:production": "pnpm --filter @roost/web test:mobile:production",
    "dev:mobile-fixture": "pnpm --filter @roost/web dev:mobile-fixture",
    "ios:generate": "python3 apps/ios/generate-project.py",
    "ios:build": "xcodebuild -project apps/ios/Roost.xcodeproj -scheme Roost -sdk iphonesimulator -derivedDataPath apps/ios/build build",
    "ios:test": "xcodebuild -project apps/ios/Roost.xcodeproj -scheme Roost -derivedDataPath apps/ios/build test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12"
  }
}
