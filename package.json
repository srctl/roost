{
  "name": "roost",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vite build --config vite.cli.config.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm test && pnpm format:check && pnpm build",
    "test": "node --import tsx --test tests/*.test.ts",
    "release:pack": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@effect/platform-node": "0.108.1",
    "@novnc/novnc": "1.5.0",
    "@stylexjs/stylex": "0.19.0",
    "@tanstack/react-router": "1.170.32",
    "@tanstack/react-start": "1.168.49",
    "effect": "3.22.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@stylexjs/unplugin": "0.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "nitro": "3.0.260903-beta",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unplugin": "2.3.11",
    "vite": "8.2.2"
  },
  "bin": {
    "roost": "bin/roost"
  },
  "license": "MIT"
}
