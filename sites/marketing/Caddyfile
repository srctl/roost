{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv

	header X-Content-Type-Options nosniff
	# Browsers revalidate mutable files; Railway caches them for five minutes.
	header Cache-Control "public, max-age=0, s-maxage=300"

	handle /healthz {
		header Cache-Control "no-store"
		respond "ok" 200
	}

	handle {
		@immutable {
			path_regexp fingerprint ^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css)$
			file
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@markdown path *.md
		header @markdown Content-Type "text/markdown; charset=utf-8"
		@text path *.txt
		header @text Content-Type "text/plain; charset=utf-8"

		# Serve only existing files, not an SPA fallback. Railway compresses them.
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_text}" {err.status_code}
	}
}
